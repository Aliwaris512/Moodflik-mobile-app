DEBUG=True
ALLOWED_HOSTS=*
SECRET_KEY=change-me
BASE_URL=http://localhost:8000
USE_REDIS_CHANNEL_LAYER=False
# Prints emails (activation links, password-reset OTPs) to the server console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST_PASSWORD=...   # for real SMTP use django.core.mail.backends.smtp.EmailBackend
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_STORAGE_BUCKET_NAME= (optional; uploads fall back to local media)
