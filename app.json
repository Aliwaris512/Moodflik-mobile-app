{
  "expo": {
    "name": "Moodflik",
    "slug": "moodflik-expo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/moodflik/app-icon.png",
    "scheme": "moodflikexpo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.moodflik.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6D0AC7",
        "foregroundImage": "./assets/moodflik/app-icon.png",
        "monochromeImage": "./assets/moodflik/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moodflik.app",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6D0AC7",
          "image": "./assets/moodflik/splash.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Moodflik uses your photos when you choose media for a post.",
          "cameraPermission": "Moodflik uses your camera when you choose to capture media.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1BDAB5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
