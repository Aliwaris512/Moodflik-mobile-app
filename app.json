{
  "expo": {
    "name": "Moodflik",
    "slug": "moodflik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moodflik",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.moodflik.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moodflik.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#00234b"
        }
      ],
      "expo-video",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "@giphy/react-native-sdk",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Moodflik to use the camera to take photos for posts.",
          "photosPermission": "Allow Moodflik to access your photos to share posts and set your profile picture."
        }
      ],
      ["expo-notifications"]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
