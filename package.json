{
  "name": "moodflik-expo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "bunx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "bunx expo start --android",
    "ios": "bunx expo start --ios",
    "web": "bunx expo start --web",
    "lint": "oxlint",
    "test": "bun test",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "build": "bunx expo export",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test",
    "prepare": "lefthook install",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "android:studio": "node scripts/open-android-studio.js",
    "android:build": "bunx expo run:android --no-bundler",
    "android:apk": "node scripts/android-apk.js",
    "android:release": "node scripts/android-apk.js release",
    "android:bundle": "node scripts/android-apk.js bundle",
    "api:gen": "powershell -NoProfile -ExecutionPolicy Bypass -File ../backend/scripts/gen_schema.ps1 && openapi-ts"
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.2",
    "@giphy/react-native-sdk": "^6.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@tanstack/db": "^1.0.0-rc.1.3",
    "@tanstack/query-async-storage-persister": "^5.106.1",
    "@tanstack/query-db-collection": "^1.5.1",
    "@tanstack/react-db": "^1.0.0-rc.1.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-persist-client": "^5.106.1",
    "axios": "^1.21.0",
    "expo": "~58.0.23",
    "expo-av": "^16.0.8",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "expo-web-browser": "~58.0.7",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
